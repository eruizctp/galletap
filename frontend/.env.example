# Supabase del ambiente (Project Settings → API). Staging y producción tienen proyectos distintos.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Avisos web push. Generar con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Errores (opcional). Proyecto en sentry.io
VITE_SENTRY_DSN=
VITE_AMBIENTE=local

# Solo en el servidor (función api/avisos en Vercel). Nunca con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
